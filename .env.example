# Public browser configuration only. NEVER put a secret or API key in VITE_*.
# Empty endpoint = prepare an inquiry and hand it off via WhatsApp / email.
# Set only after deploying an endpoint that implements docs/RFP-ENDPOINT.md.
VITE_RFP_ENDPOINT=
# Optional. Name of your actual submission provider, shown in the privacy notice.
VITE_RFP_PROVIDER_LABEL=
# Custom domain uses /. For a repository subpath use /thesmartinnovation/.
VITE_BASE_PATH=/
